ARG ROCM_VERSION=10.0.0-full
FROM rocm/dev-ubuntu-22.04:${ROCM_VERSION} AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV ROCM_PATH="/opt/rocm"
ENV HIP_PATH="/opt/rocm"
ENV PATH="/opt/rocm/bin:/opt/rocm/llvm/bin:${PATH}"
ARG LLAMA_CPP_TAG=b10689

# ビルドに必要なシステムパッケージのみインストール
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    build-essential \
    libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. mio-tts-cpp のソースを配置
COPY . /app

# 2. 依存する llama.cpp を配置 (b10689 でバージョン固定)
RUN git clone --depth 1 --branch ${LLAMA_CPP_TAG} https://github.com/ggerganov/llama.cpp.git /app/llama.cpp

# ビルド実行 (gfx1151 / Strix Point / Halo APU 等に対応)
RUN mkdir build && cd build && \
    CC=amdclang CXX=hipcc cmake .. \
      -DLLAMA_CPP_SOURCE_DIR=/app/llama.cpp \
      -DGGML_HIP=ON \
      -DAMDGPU_TARGETS=gfx1151 \
      -DGPU_TARGETS=gfx1151 \
      -DCMAKE_BUILD_TYPE=Release && \
    cmake --build . --config Release -j$(nproc)

# ビルドされた共有ライブラリ（libllama.so, libggml.so 等）を /app/build/lib に集約
RUN mkdir -p /app/build/lib && \
    find /app/build -name "*.so*" -exec cp -P {} /app/build/lib/ \;

# ランタイムに必要な最小限の ROCm 共有ライブラリ（HIP/HSA/ROCm-core）を /app/rocm-lib に抽出
RUN mkdir -p /app/rocm-lib && \
    find /opt/rocm/lib /opt/rocm/core-*/lib \
      \( -name "libamdhip64.so*" -o \
         -name "libhiprtc.so*" -o \
         -name "libhsa-runtime64.so*" -o \
         -name "librocm-core.so*" -o \
         -name "librocm_smi64.so*" -o \
         -name "libamd_comgr.so*" \) \
      -exec cp -P {} /app/rocm-lib/ \; 2>/dev/null || true

# 実行用ステージ (軽量な Ubuntu 22.04 ベース: 約300-500MB)
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ROCM_PATH="/opt/rocm"
ENV PATH="/opt/rocm/bin:${PATH}"
ENV LD_LIBRARY_PATH="/app/lib:/opt/rocm/lib:${LD_LIBRARY_PATH}"

# 実行に必要な最小限のシステムライブラリのみインストール
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    libnuma1 \
    libdrm2 \
    libdrm-amdgpu1 \
    libelf1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 実行バイナリ、アプリ共有ライブラリ、および抽出した ROCm ランタイムをコピー
COPY --from=builder /app/build/mio-tts-server /app/mio-tts-server
COPY --from=builder /app/build/lib/ /app/lib/
COPY --from=builder /app/rocm-lib/ /opt/rocm/lib/

EXPOSE 18089

ENTRYPOINT ["./mio-tts-server"]
