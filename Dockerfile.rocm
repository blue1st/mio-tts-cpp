ARG UBUNTU_VERSION=22.04
ARG ROCM_VERSION=10.0.0-full
FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION} AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV ROCM_PATH="/opt/rocm"
ENV HIP_PATH="/opt/rocm"
ENV PATH="/opt/rocm/bin:/opt/rocm/llvm/bin:${PATH}"
ARG LLAMA_CPP_TAG=b10689

# ビルドに必要なシステムパッケージのみインストール
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    build-essential \
    libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. mio-tts-cpp のソースを配置
COPY . /app

# 2. 依存する llama.cpp を配置 (b10689 でバージョン固定)
RUN git clone --depth 1 --branch ${LLAMA_CPP_TAG} https://github.com/ggerganov/llama.cpp.git /app/llama.cpp

# ビルド実行 (gfx1151 / Strix Point / Halo APU 等に対応、不要な量子化FAテンプレート展開を抑制して高速化)
RUN mkdir build && cd build && \
    CC=amdclang CXX=hipcc cmake .. \
      -DLLAMA_CPP_SOURCE_DIR=/app/llama.cpp \
      -DGGML_HIP=ON \
      -DAMDGPU_TARGETS=gfx1151 \
      -DGPU_TARGETS=gfx1151 \
      -DGGML_CUDA_FA_ALL_QUANTS=OFF \
      -DCMAKE_BUILD_TYPE=Release && \
    cmake --build . --config Release -j$(nproc)

# 不要な巨大コンパイラ・ヘッダー・ドキュメント等を削除し、成果物を /app/dist に集約
RUN mkdir -p /app/dist/app/lib /app/dist/opt && \
    cp /app/build/mio-tts-server /app/dist/app/ && \
    find /app/build -name "*.so*" -exec cp -P {} /app/dist/app/lib/ \; && \
    rm -rf /opt/rocm/llvm \
           /opt/rocm/include \
           /opt/rocm/share \
           /opt/rocm/core-*/include \
           /opt/rocm/core-*/share && \
    find /opt/rocm -name "*.a" -delete && \
    cp -a /opt/rocm /app/dist/opt/

# ビルド時検証: 依存関係がすべて解決し、バイナリが正常起動することを確認
RUN LD_LIBRARY_PATH="/app/dist/app/lib:/app/dist/opt/rocm/lib:/app/dist/opt/rocm/core-10.0/lib" ldd /app/dist/app/mio-tts-server && \
    ! LD_LIBRARY_PATH="/app/dist/app/lib:/app/dist/opt/rocm/lib:/app/dist/opt/rocm/core-10.0/lib" ldd /app/dist/app/mio-tts-server | grep "not found" && \
    LD_LIBRARY_PATH="/app/dist/app/lib:/app/dist/opt/rocm/lib:/app/dist/opt/rocm/core-10.0/lib" /app/dist/app/mio-tts-server --help > /dev/null

# 実行用ステージ (最小限の3レイヤー構成)
FROM ubuntu:${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive \
    ROCM_PATH="/opt/rocm" \
    PATH="/opt/rocm/bin:${PATH}" \
    LD_LIBRARY_PATH="/app/lib:/opt/rocm/lib:/opt/rocm/core-10.0/lib"

# 1. 実行に必要な最小限のシステムライブラリのみインストール (レイヤー1)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    libnuma1 \
    libdrm2 \
    libdrm-amdgpu1 \
    libelf1 \
    libomp5 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. アプリケーションおよび軽量化された ROCm ランタイムを一括配置 (レイヤー2)
COPY --from=builder /app/dist/ /

EXPOSE 18089

ENTRYPOINT ["./mio-tts-server"]
