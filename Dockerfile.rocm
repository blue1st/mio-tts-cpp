ARG UBUNTU_VERSION=22.04
ARG ROCM_VERSION=10.0.0-full
FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION} AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV ROCM_PATH="/opt/rocm"
ENV HIP_PATH="/opt/rocm"
ENV PATH="/opt/rocm/bin:/opt/rocm/llvm/bin:${PATH}"
ARG LLAMA_CPP_TAG=b10689

# ビルドに必要なシステムパッケージのみインストール
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    build-essential \
    libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. mio-tts-cpp のソースを配置
COPY . /app

# 2. 依存する llama.cpp を配置 (b10689 でバージョン固定)
RUN git clone --depth 1 --branch ${LLAMA_CPP_TAG} https://github.com/ggerganov/llama.cpp.git /app/llama.cpp

# ビルド実行 (gfx1151 / Strix Point / Halo APU 等に対応)
RUN mkdir build && cd build && \
    CC=amdclang CXX=hipcc cmake .. \
      -DLLAMA_CPP_SOURCE_DIR=/app/llama.cpp \
      -DGGML_HIP=ON \
      -DAMDGPU_TARGETS=gfx1151 \
      -DGPU_TARGETS=gfx1151 \
      -DCMAKE_BUILD_TYPE=Release && \
    cmake --build . --config Release -j$(nproc)

# ビルドされた共有ライブラリ（libllama.so, libggml.so 等）を /app/build/lib に集約
RUN mkdir -p /app/build/lib && \
    find /app/build -name "*.so*" -exec cp -P {} /app/build/lib/ \;

# ランタイムに必要なすべての ROCm / OpenMP / hipBLAS 共有ライブラリを ldd と find で網羅的に抽出
RUN mkdir -p /app/rocm-lib && \
    python3 -c '\
import subprocess, os, shutil\
resolved = set()\
frontier = set(["/app/build/mio-tts-server"] + [os.path.join("/app/build/lib", f) for f in os.listdir("/app/build/lib") if os.path.isfile(os.path.join("/app/build/lib", f))])\
while frontier:\
    curr = frontier.pop()\
    if not os.path.exists(curr):\
        continue\
    try:\
        out = subprocess.check_output(["ldd", curr], text=True, errors="ignore")\
        for line in out.splitlines():\
            if "=>" in line and "/opt/rocm" in line:\
                p = line.split("=>")[1].split("(")[0].strip()\
                if os.path.isfile(p) and p not in resolved:\
                    resolved.add(p)\
                    frontier.add(p)\
    except Exception:\
        pass\
for lib in sorted(resolved):\
    print("Resolved ROCm lib:", lib)\
    shutil.copy(lib, "/app/rocm-lib/")\
' && \
    find /opt/rocm \
      \( -name "libamdhip64.so*" -o \
         -name "libhiprtc.so*" -o \
         -name "libhsa-runtime64.so*" -o \
         -name "librocm-core.so*" -o \
         -name "librocm_smi64.so*" -o \
         -name "libamd_comgr.so*" -o \
         -name "libhipblas*.so*" -o \
         -name "librocblas*.so*" -o \
         -name "libomp*.so*" \) \
      -exec cp -P {} /app/rocm-lib/ \; 2>/dev/null || true

# 実行用ステージ (軽量な Ubuntu ベース: 約300-500MB)
FROM ubuntu:${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive
ENV ROCM_PATH="/opt/rocm"
ENV PATH="/opt/rocm/bin:${PATH}"
ENV LD_LIBRARY_PATH="/app/lib:/opt/rocm/lib:${LD_LIBRARY_PATH}"

# 実行に必要な最小限のシステムライブラリのみインストール
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    libnuma1 \
    libdrm2 \
    libdrm-amdgpu1 \
    libelf1 \
    libomp5 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 実行バイナリ、アプリ共有ライブラリ、および抽出した ROCm ランタイムをコピー
COPY --from=builder /app/build/mio-tts-server /app/mio-tts-server
COPY --from=builder /app/build/lib/ /app/lib/
COPY --from=builder /app/rocm-lib/ /opt/rocm/lib/

EXPOSE 18089

ENTRYPOINT ["./mio-tts-server"]
